@page
@model SKARB.Web.Pages.Admin.EditModel
@{
	ViewData["Title"] = "Редактировать пользователя";
}

<link rel="stylesheet" href="~/css/admin-style.css" asp-append-version="true" />

<h2>@ViewData["Title"]</h2>

<div class="row">
	<div class="col-md-6">
		<form method="post">
			<input asp-for="Input.Id" type="hidden" />

			<div asp-validation-summary="All" class="text-danger"></div>

			@* <div class="form-group mb-3">
				<label asp-for="Input.Email"></label>
				<input asp-for="Input.Email" class="form-control" />
				<span asp-validation-for="Input.Email" class="text-danger"></span>
			</div> *@

			<div class="form-group mb-3">
				<label asp-for="Input.UserName"></label>
				<input asp-for="Input.UserName" class="form-control" />
				<span asp-validation-for="Input.UserName" class="text-danger"></span>
			</div>

			<div class="form-group mb-3">
				<label asp-for="Input.NewPassword"></label>
				<a href="#"
				   data-bs-toggle="tooltip"
				   data-bs-placement="right"
				   title="Требования к паролю:
• Не менее 6 символов
• Хотя бы одна строчная буква
• Хотя бы одна заглавная буква
• Хотя бы одна цифра
• Хотя бы один спецсимвол">
					<i class=" text-muted">?</i>
				</a>
				<div class="input-group">
					<input asp-for="Input.NewPassword" class="form-control" type="text" id="newPassword" />
					<button type="button" class="btn btn-outline-secondary" onclick="generatePassword('newPassword', 'Input_ConfirmPassword')">Сгенерировать</button>
				</div>
				<span asp-validation-for="Input.NewPassword" class="text-danger"></span>
			</div>

			<div class="form-group mb-3">
				<label asp-for="Input.ConfirmPassword"></label>
				<input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
				<span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
			</div>
			<div class="form-group mb-3">
				<div class="form-check">
					<input asp-for="Input.IsLocked" class="form-check-input" />
					<label class="form-check-label" asp-for="Input.IsLocked">Заблокировать пользователя</label>
				</div>
			</div>

			<div class="form-group mb-3">
				<label>Роли</label><br />
				@foreach (var role in Model.AllRoles)
				{
					<div class="form-check">
						<input type="checkbox" name="SelectedRoles" value="@role" class="form-check-input" id="role_@role" @(Model.Input.UserRoles.Contains(role) ? "checked" : "") />
						<label class="form-check-label" for="role_@role">@role</label>
					</div>
				}
			</div>

			<div class="form-group save-section">
				<input type="submit" value="Сохранить" class="btn func-button add-user-button mobile-button" />
				<a class="btn func-button func-alt-button add-user-button mobile-button" asp-page="./Index">Обратно к списку</a>
			</div>
		</form>
	</div>
</div>