@page
@model SKARB.Web.Pages.Admin.CreateModel
@{
	ViewData["Title"] = "Добавление пользователя";
}

<link rel="stylesheet" href="~/css/admin-style.css" asp-append-version="true" />

<h2>@ViewData["Title"]</h2>

<div class="row">
	<div class="col-md-6">
		<form method="post">
			<div asp-validation-summary="All" class="text-danger"></div>

			<div class="form-group mb-3">
				<label asp-for="Input.UserName"></label><span class="text-danger"> *</span>
				<input asp-for="Input.UserName" class="form-control" />
			</div>

			@* <div class="form-group mb-3">
				<label asp-for="Input.Email"></label>
				<input asp-for="Input.Email" class="form-control" />
			</div> *@

			<div class="form-group mb-3">
				<label asp-for="Input.Password"></label>
				<span class="text-danger"> *</span>
				<a href="#"
				   data-bs-toggle="tooltip"
				   data-bs-placement="right"
				   title="Требования к паролю:
• Не менее 6 символов
• Хотя бы одна строчная буква
• Хотя бы одна заглавная буква
• Хотя бы одна цифра
• Хотя бы один спецсимвол">
					<i class="text-muted">?</i>
				</a>
				<div class="input-group">
					<input asp-for="Input.Password" class="form-control" type="text" id="passwordField" autocomplete="new-password" />
					<button type="button" class="btn btn-outline-secondary" onclick="generatePassword('passwordField', 'confirmPasswordField')">Сгенерировать</button>
				</div>

			</div>

			<div class="form-group mb-3">
				<label asp-for="Input.ConfirmPassword"></label>
				<span class="text-danger"> *</span>
				<input asp-for="Input.ConfirmPassword" class="form-control" type="password" id="confirmPasswordField" autocomplete="new-password" />
			</div>

			<div class="form-group mb-3">
				<label>Роли:</label><br />
				@foreach (var role in Model.AllRoles)
				{
					<div class="form-check">
						<input type="checkbox" name="SelectedRoles" value="@role" class="form-check-input" id="role_@role" />
						<label class="form-check-label" for="role_@role">@role</label>
					</div>
				}
			</div>

			<div class="form-group save-section">
				<input type="submit" value="Сохранить" class="btn func-button add-user-button mobile-button" />
				<a class="btn func-button func-alt-button add-user-button mobile-button" asp-page="./Index">Обратно к списку</a>
			</div>
		</form>
	</div>
</div>