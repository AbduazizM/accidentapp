@page
@using System.Security.Claims
@model SKARB.Web.Pages.Admin.IndexModel
@{
	ViewData["Title"] = "Учётные записи";
}

<link rel="stylesheet" href="~/css/admin-style.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/grid-page.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<h3>@ViewData["Title"]</h3>

<div class="table-responsive table-wrapper">
	<table class="table table-striped table-hover align-middle">
		<thead class="table-dark">
			<tr>
				<th class="text-start">Имя пользователя</th>
				<th class="text-start">Заблокирован</th>
				<th class="text-start">Роли</th>
				<th class="text-end">Действия</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var user in Model.Users)
			{
				<tr>
					<td>@user.UserName</td>
					<td>@(user.LockoutEnd.HasValue && user.LockoutEnd > DateTime.Now ? "Да" : "Нет")</td>
					<td>
						@{
							var roles = await Model._userManager.GetRolesAsync(user);
							@string.Join(", ", roles)
						}
					</td>
					<td class="text-end paddind-th">
						<a asp-page="./Edit" asp-route-id="@user.Id" class="btn bordered-button table-button">Редактировать</a>
						@if (user.Id != User.FindFirstValue(ClaimTypes.NameIdentifier))
						{
							<a asp-page="./Delete" asp-route-id="@user.Id" class="btn bordered-button table-button">Удалить</a>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

<a asp-page="./Create" class="btn func-button add-user-button mobile-button">Добавить пользователя</a>