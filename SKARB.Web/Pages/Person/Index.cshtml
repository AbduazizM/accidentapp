@page
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model SKARB.Web.Pages.Person.IndexModel

@{
	ViewData["Title"] = "База участвующих лиц";
}

<link rel="stylesheet" href="~/css/grid-page.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<h2>@ViewData["Title"]</h2>

<div class="adaptive-form-container mb-4">
	<form method="get" class="d-flex flex-column gap-3">
		<div class="d-flex flex-wrap gap-2 align-items-end controller-base">
			<input type="text" name="searchFio" value="@Model.SearchFio"
				   placeholder="Поиск по ФИО" class="form-control search-controller" />

			<input type="text" name="searchAddress" value="@Model.SearchAddress"
				   placeholder="Адрес" class="form-control search-controller" />

			<div class="d-flex gap-2">
				<input type="number" name="minConvictions" value="@Model.MinConvictions" min="0"
					   placeholder="Судимостей от" class="form-control" style="width: 120px;" />
				<input type="number" name="maxConvictions" value="@Model.MaxConvictions" min="0"
					   placeholder="до" class="form-control" style="width: 100px;" />
			</div>

			<div class="d-flex gap-2">
				<button type="submit" class="btn func-button">Найти</button>
				<a asp-page="./Index" class="btn func-button func-alt-button">Сброс</a>
			</div>
		</div>
	</form>
</div>

<!-- Таблица -->
<div class="table-responsive table-wrapper">
	<table class="table table-striped table-hover align-middle">
		<thead class="table-dark">
			<tr>
				<th class="text-start">@Html.DisplayNameFor(m => m.Person[0].LastName)</th>
				<th class="text-start">@Html.DisplayNameFor(m => m.Person[0].FirstName)</th>
				<th class="text-start">@Html.DisplayNameFor(m => m.Person[0].MiddleName)</th>
				<th class="text-start">@Html.DisplayNameFor(m => m.Person[0].Address)</th>
				<th class="text-start">@Html.DisplayNameFor(m => m.Person[0].Convictoins)</th>
				<th class="text-end">Действия</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model.Person)
			{
				<tr>
					<td>@Html.DisplayFor(m => item.LastName)</td>
					<td>@Html.DisplayFor(m => item.FirstName)</td>
					<td>@Html.DisplayFor(m => item.MiddleName)</td>
					<td>@Html.DisplayFor(m => item.Address)</td>
					<td>@Html.DisplayFor(m => item.Convictoins)</td>
					<td class="button-container align-items-end">
						@if ((await AuthorizationService.AuthorizeAsync(User, "CanEditOrDelete")).Succeeded)
						{
							<a asp-page="./Edit" class="btn btn-sm bordered-button" asp-route-id="@item.PersonId">Редактировать</a>
							<a asp-page="./Details" class="btn btn-sm bordered-button" asp-route-id="@item.PersonId">Подробнее</a>
							<a asp-page="./Delete" class="btn btn-sm bordered-button" asp-route-id="@item.PersonId">Удалить</a>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

<a asp-page="Create" class="btn func-button mobile-button">Добавить лицо</a>