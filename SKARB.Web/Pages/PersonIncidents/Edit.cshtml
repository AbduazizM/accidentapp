@page
@model SKARB.Web.Pages.PersonIncidents.EditModel

@{
    ViewData["Title"] = "Редактирование соответствия";
}


<h2>@ViewData["Title"]</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PersonIncident.Id" />
            <div class="form-group">
                
                <label asp-for="PersonIncident.PersonId" class="control-label"></label>
                <select asp-for="PersonIncident.PersonId" class="form-control" asp-items="ViewBag.PersonId"></select>
                <span asp-validation-for="PersonIncident.PersonId" class="text-danger"></span>
            </div>
            <div class="form-group">
                
                <label asp-for="PersonIncident.IncidentId" class="control-label"></label>
                <select asp-for="PersonIncident.IncidentId" class="form-control" asp-items="ViewBag.IncidentId"></select>
                <span asp-validation-for="PersonIncident.IncidentId" class="text-danger"></span>
            </div>
            <div class="form-group">
                
                <label asp-for="PersonIncident.IncidentRoleId" class="control-label"></label>
                <select asp-for="PersonIncident.IncidentRoleId" class="form-control" asp-items="ViewBag.IncidentRoleId"></select>
                <span asp-validation-for="PersonIncident.IncidentRoleId" class="text-danger"></span>
            </div>
            <div class="form-group save-section">
                <input type="submit" value="Сохранить" class="btn func-button add-user-button mobile-button" />
                <a class="btn func-button func-alt-button add-user-button mobile-button" asp-page="./Index">Обратно к списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
