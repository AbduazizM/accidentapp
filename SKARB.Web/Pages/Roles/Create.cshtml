@page
@model SKARB.Web.Pages.Roles.CreateModel

@{
	ViewData["Title"] = "Добавление роли";
}

<h2>@ViewData["Title"]</h2>
<hr />
<div class="row">
	<div class="col-md-4">
		<form method="post">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<div class="form-group">
				<label asp-for="IncidentRole.IncidentRoleName" class="control-label"></label>
				<input asp-for="IncidentRole.IncidentRoleName" class="form-control" />
				<span asp-validation-for="IncidentRole.IncidentRoleName" class="text-danger"></span>
			</div>
			<div class="form-group save-section">
				<input type="submit" value="Сохранить" class="btn func-button add-user-button mobile-button" />
				<a class="btn func-button func-alt-button add-user-button mobile-button" asp-page="./Index">Обратно к списку</a>
			</div>
		</form>
	</div>
</div>


@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
