@page
@model SKARB.Web.Pages.Incident.DeleteModel

@{
    ViewData["Title"] = "Удаление происшествия";
}

<h2>@ViewData["Title"]</h2>
<div>
    <h4>Incident</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Incident.IncidentDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Incident.IncidentDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Incident.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Incident.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Incident.Decision)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Incident.Decision.DecisionName)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Incident.IncidentId" />
        <div class="button-container">
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
        </div>
    </form>
</div>
