@page
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model SKARB.Web.Pages.Incident.IndexModel

@{
    ViewData["Title"] = "База происшествий";
}

<link rel="stylesheet" href="~/css/grid-page.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<h2>@ViewData["Title"]</h2>
<div class="adaptive-form-container mb-4">
    <form method="get" class="d-flex flex-column gap-3">
        <div class="d-flex flex-wrap gap-2 align-items-end controller-base">
            <input type="text" name="searchRegNumber" value="@Model.SearchRegNumber"
                   placeholder="Номер происшествия" class="form-control search-controller" />

            <input type="text" name="searchDescription" value="@Model.SearchDescription"
                   placeholder="Описание" class="form-control search-controller" />

            <select name="decisionId" class="form-select" style="min-width: 160px;">
                <option value="-1">Все решения</option>
                @foreach (var decision in Model.Decisions)
                {
                    <option value="@decision.DecisionId"
                            selected="@(Model.DecisionId == decision.DecisionId ? "selected" : null)">
                        @decision.DecisionName
                    </option>
                }
            </select>

            <div class="d-flex gap-2">
                <input type="date" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))"
                       class="form-control" style="width: 140px;" />
                <input type="date" name="dateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                       class="form-control" style="width: 140px;" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn func-button">Найти</button>
                <a asp-page="./Index" class="btn func-button func-alt-button">Сброс</a>
            </div>
        </div>
    </form>
</div>

<div class="table-responsive table-wrapper">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th class="text-start">@Html.DisplayNameFor(m => m.Incident[0].RegNumber)</th>
                <th class="text-start">@Html.DisplayNameFor(m => m.Incident[0].IncidentDate)</th>
                <th class="text-start">@Html.DisplayNameFor(m => m.Incident[0].Description)</th>
                <th class="text-start">@Html.DisplayNameFor(m => m.Incident[0].Decision)</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Incident)
            {
                <tr>
                    <td>@Html.DisplayFor(m => item.RegNumber)</td>
                    <td>@Html.DisplayFor(m => item.IncidentDate)</td>
                    <td>@Html.DisplayFor(m => item.Description)</td>
                    <td>@Html.DisplayFor(m => item.Decision.DecisionName)</td>
                    <td class="button-container align-items-end">
                        @if ((await AuthorizationService.AuthorizeAsync(User, "CanEditOrDelete")).Succeeded)
                        {
                            <a asp-page="./Edit" class="btn btn-sm bordered-button" asp-route-id="@item.IncidentId">Редактировать</a>
                            <a asp-page="./Details" class="btn btn-sm bordered-button" asp-route-id="@item.IncidentId">Подробнее</a>
                            <a asp-page="./Delete" class="btn btn-sm bordered-button" asp-route-id="@item.IncidentId">Удалить</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-page="Create" class="btn func-button mobile-button">Добавить происшествие</a>